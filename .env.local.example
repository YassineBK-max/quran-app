# Copy this file to .env.local and fill in your credentials

# Supabase — from supabase.com → Project Settings → API
# REQUIRED: this is the app's only account system (Supabase Auth) and
# database (Course Classrooms, attendance, payments, etc). After setting
# these, run supabase/migration.sql once in the Supabase SQL Editor.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google sign-in is currently disabled (it used to go through NextAuth,
# which assumed local per-device accounts — see AuthContext.tsx). If you
# reconnect it, prefer Supabase's own Google OAuth provider instead of
# NextAuth, so it produces a real Supabase Auth session directly.
